#!/bin/sh
# Rejects commit messages that don't follow Conventional Commits (https://www.conventionalcommits.org).
# Enabled by `npm install` (it runs `git config core.hooksPath .githooks`).
subject=$(head -n 1 "$1")
case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac
if ! printf '%s' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: [^ ].{0,99}$'; then
  echo "✗ Commit message must follow Conventional Commits:" >&2
  echo "    <type>(<optional scope>)<optional !>: <subject>" >&2
  echo "  types: feat fix docs style refactor perf test build ci chore revert" >&2
  echo "  example: feat(panel): add a custom input box" >&2
  echo "  got:     $subject" >&2
  exit 1
fi
