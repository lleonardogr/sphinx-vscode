{
  "title": "Rectangle Area and Perimeter",
  "topic": "Variables",
  "difficulty": "Easy",
  "order": 4,
  "hints": [
    "scanner.nextDouble() reads a decimal number.",
    "%.2f means: a decimal number with 2 digits after the point. \"Area: %.2f\".formatted(area) builds the text."
  ],
  "mustContain": [
    {
      "pattern": "\\bdouble\\b",
      "message": "Use double variables for decimal numbers."
    }
  ],
  "tests": [
    {
      "input": "5 2.5\n",
      "output": "Area: 12.50\nPerimeter: 15.00\n"
    },
    {
      "input": "3 4\n",
      "output": "Area: 12.00\nPerimeter: 14.00\n"
    },
    {
      "input": "0.1 0.2\n",
      "output": "Area: 0.02\nPerimeter: 0.60\n",
      "hidden": true
    },
    {
      "input": "10.75 3.2\n",
      "output": "Area: 34.40\nPerimeter: 27.90\n",
      "hidden": true
    },
    {
      "input": "1000 1000\n",
      "output": "Area: 1000000.00\nPerimeter: 4000.00\n",
      "hidden": true
    }
  ]
}
