{
  "title": "Days in a Month (Switch Expression)",
  "topic": "Conditionals",
  "difficulty": "Medium",
  "order": 7,
  "hints": [
    "Group the months: case 1, 3, 5, 7, 8, 10, 12 -> 31; and case 4, 6, 9, 11 -> 30;",
    "A switch expression must cover every value, so it needs a default -> branch.",
    "For February, compute leap first and use a ternary inside the case: case 2 -> leap ? 29 : 28;"
  ],
  "mustContain": [
    {
      "pattern": "\\bswitch\\b",
      "message": "Use a switch."
    },
    {
      "pattern": "\\bcase\\b[^:;\\n]*->",
      "message": "Use arrow labels (case 4, 6, 9, 11 -> 30;), the switch-expression style."
    }
  ],
  "tests": [
    {
      "input": "1\n2025\n",
      "output": "31\n"
    },
    {
      "input": "2\n2024\n",
      "output": "29\n"
    },
    {
      "input": "2\n2023\n",
      "output": "28\n",
      "hidden": true
    },
    {
      "input": "2\n1900\n",
      "output": "28\n",
      "hidden": true
    },
    {
      "input": "2\n2000\n",
      "output": "29\n",
      "hidden": true
    },
    {
      "input": "11\n2025\n",
      "output": "30\n",
      "hidden": true
    },
    {
      "input": "13\n2025\n",
      "output": "Invalid month\n",
      "hidden": true
    },
    {
      "input": "0\n2025\n",
      "output": "Invalid month\n",
      "hidden": true
    }
  ]
}
