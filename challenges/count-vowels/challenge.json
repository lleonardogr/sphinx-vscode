{
  "title": "Count Vowels",
  "topic": "Strings",
  "difficulty": "Easy",
  "order": 2,
  "hints": [
    "Loop over every character with text.charAt(i).",
    "A char is written with single quotes: 'a'. Compare with ==.",
    "text.toLowerCase() turns the whole text into lowercase, so you only need to check lowercase vowels."
  ],
  "mustContain": [
    {
      "pattern": "\\b(for|while)\\b",
      "message": "Use a loop (for or while)."
    }
  ],
  "tests": [
    {
      "input": "Hello World\n",
      "output": "3\n"
    },
    {
      "input": "Programming in Java\n",
      "output": "6\n"
    },
    {
      "input": "rhythm\n",
      "output": "0\n",
      "hidden": true
    },
    {
      "input": "AEIOU aeiou\n",
      "output": "10\n",
      "hidden": true
    },
    {
      "input": "xyz 123\n",
      "output": "0\n",
      "hidden": true
    }
  ]
}
