{
  "name": "sphynx",
  "displayName": "Sphynx",
  "description": "LeetCode/HackerRank-style coding challenges inside VS Code, with mixed-skill tests, quizzes, timed exams and optional AI hints from a local model or your own API key. Starts with Java: variables, conditionals, loops, arrays, strings, methods and OOP.",
  "version": "0.6.0",
  "publisher": "class-plugin",
  "license": "MIT",
  "icon": "media/logo/icon.png",
  "galleryBanner": {
    "color": "#0d1627",
    "theme": "dark"
  },
  "author": "lleonardogr",
  "repository": {
    "type": "git",
    "url": "https://github.com/lleonardogr/sphynx-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/lleonardogr/sphynx-vscode/issues"
  },
  "homepage": "https://github.com/lleonardogr/sphynx-vscode#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Education"
  ],
  "keywords": [
    "ai",
    "challenges",
    "education",
    "exercises",
    "java",
    "oop",
    "practice",
    "students",
    "tutor"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sphynx",
          "title": "Sphynx",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "sphynx": [
        {
          "id": "sphynx.list",
          "name": "Challenges"
        }
      ]
    },
    "commands": [
      {
        "command": "sphynx.open",
        "title": "Open Challenge",
        "category": "Sphynx",
        "icon": "$(go-to-file)"
      },
      {
        "command": "sphynx.run",
        "title": "Run Sample Tests",
        "category": "Sphynx",
        "icon": "$(play)"
      },
      {
        "command": "sphynx.submit",
        "title": "Submit (Run All Tests)",
        "category": "Sphynx",
        "icon": "$(check-all)"
      },
      {
        "command": "sphynx.runInTerminal",
        "title": "Run in Terminal (Type Input Yourself)",
        "category": "Sphynx",
        "icon": "$(terminal)"
      },
      {
        "command": "sphynx.resetCode",
        "title": "Reset Code to Starter",
        "category": "Sphynx",
        "icon": "$(discard)"
      },
      {
        "command": "sphynx.refresh",
        "title": "Reload Challenges",
        "category": "Sphynx",
        "icon": "$(refresh)"
      },
      {
        "command": "sphynx.resetProgress",
        "title": "Reset All Progress",
        "category": "Sphynx",
        "icon": "$(clear-all)"
      },
      {
        "command": "sphynx.askAiHint",
        "title": "Ask AI for a Hint",
        "category": "Sphynx",
        "icon": "$(sparkle)"
      },
      {
        "command": "sphynx.setupAi",
        "title": "Set Up AI Hints (Local Model or API Key)",
        "category": "Sphynx",
        "icon": "$(settings-gear)"
      },
      {
        "command": "sphynx.clearAiKeys",
        "title": "Remove Saved AI API Keys",
        "category": "Sphynx",
        "icon": "$(trash)"
      },
      {
        "command": "sphynx.createChallenge",
        "title": "Create New Challenge…",
        "category": "Sphynx",
        "icon": "$(new-file)"
      },
      {
        "command": "sphynx.openQuiz",
        "title": "Open Quiz…",
        "category": "Sphynx"
      },
      {
        "command": "sphynx.importContent",
        "title": "Import Challenges, Quizzes, Tests or Exams…",
        "category": "Sphynx",
        "icon": "$(desktop-download)"
      },
      {
        "command": "sphynx.removeImported",
        "title": "Remove Imported Challenges, Quizzes, Tests or Exams…",
        "category": "Sphynx"
      },
      {
        "command": "sphynx.validateChallenges",
        "title": "Validate Challenges in a Folder…",
        "category": "Sphynx",
        "icon": "$(checklist)"
      },
      {
        "command": "sphynx.startExam",
        "title": "Start Exam…",
        "category": "Sphynx",
        "icon": "$(play)"
      },
      {
        "command": "sphynx.finishExam",
        "title": "Finish Exam…",
        "category": "Sphynx",
        "icon": "$(debug-stop)"
      },
      {
        "command": "sphynx.openExamResults",
        "title": "Open Exam Results",
        "category": "Sphynx",
        "icon": "$(output)"
      },
      {
        "command": "sphynx.saveExamResults",
        "title": "Save a Copy of Exam Results…",
        "category": "Sphynx",
        "icon": "$(save-as)"
      },
      {
        "command": "sphynx.verifyExamResults",
        "title": "Verify Students' Exam Results… (Teachers)",
        "category": "Sphynx",
        "icon": "$(verified)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sphynx.importContent",
          "when": "view == sphynx.list",
          "group": "navigation@0"
        },
        {
          "command": "sphynx.removeImported",
          "when": "view == sphynx.list",
          "group": "import"
        },
        {
          "command": "sphynx.createChallenge",
          "when": "view == sphynx.list",
          "group": "navigation@0"
        },
        {
          "command": "sphynx.refresh",
          "when": "view == sphynx.list",
          "group": "navigation@1"
        },
        {
          "command": "sphynx.resetProgress",
          "when": "view == sphynx.list"
        },
        {
          "command": "sphynx.validateChallenges",
          "when": "view == sphynx.list",
          "group": "authoring"
        },
        {
          "command": "sphynx.setupAi",
          "when": "view == sphynx.list",
          "group": "ai"
        },
        {
          "command": "sphynx.verifyExamResults",
          "when": "view == sphynx.list",
          "group": "authoring"
        }
      ],
      "view/item/context": [
        {
          "command": "sphynx.resetCode",
          "when": "view == sphynx.list && viewItem == challenge"
        },
        {
          "command": "sphynx.startExam",
          "when": "view == sphynx.list && viewItem == exam-notStarted",
          "group": "inline"
        },
        {
          "command": "sphynx.startExam",
          "when": "view == sphynx.list && viewItem == exam-notStarted"
        },
        {
          "command": "sphynx.finishExam",
          "when": "view == sphynx.list && viewItem == exam-active",
          "group": "inline"
        },
        {
          "command": "sphynx.finishExam",
          "when": "view == sphynx.list && viewItem == exam-active"
        },
        {
          "command": "sphynx.openExamResults",
          "when": "view == sphynx.list && viewItem == exam-finished",
          "group": "inline"
        },
        {
          "command": "sphynx.openExamResults",
          "when": "view == sphynx.list && viewItem == exam-finished"
        },
        {
          "command": "sphynx.saveExamResults",
          "when": "view == sphynx.list && viewItem == exam-finished"
        }
      ],
      "editor/title": [
        {
          "command": "sphynx.run",
          "when": "sphynx.isChallengeFile",
          "group": "navigation@1"
        },
        {
          "command": "sphynx.runInTerminal",
          "when": "sphynx.isChallengeFile",
          "group": "navigation@2"
        },
        {
          "command": "sphynx.submit",
          "when": "sphynx.isChallengeFile",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "sphynx.resetCode",
          "when": "sphynx.isChallengeFile"
        },
        {
          "command": "sphynx.askAiHint",
          "when": "sphynx.isChallengeFile"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sphynx.run",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "sphynx.isChallengeFile"
      },
      {
        "command": "sphynx.submit",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "sphynx.isChallengeFile"
      }
    ],
    "configuration": {
      "title": "Sphynx",
      "properties": {
        "sphynx.java.home": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a JDK installation (the folder that contains `bin/javac`). Leave empty to use `javac`/`java` from your PATH."
        },
        "sphynx.java.style": {
          "type": "string",
          "enum": [
            "modern",
            "classic"
          ],
          "default": "modern",
          "enumDescriptions": [
            "Java 25+ compact source files: void main() and IO.println (requires JDK 25 or newer)",
            "Classic public class Main with public static void main(String[] args) and System.out.println (JDK 17+)"
          ],
          "markdownDescription": "Style of the starter code for new challenges. Both styles are always accepted when you run or submit, because only the output is checked. Use **Reset Code to Starter** to switch a challenge you already opened."
        },
        "sphynx.codeFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder where your solutions are saved (one sub-folder per challenge). Leave empty to use `sphynx/` inside the open workspace, or the extension's private storage when no folder is open."
        },
        "sphynx.extraChallengePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra folders containing challenges (same format as the built-in ones). Teachers can use this to hand out new challenges without rebuilding the extension."
        },
        "sphynx.ai.provider": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "ollama",
            "lmstudio",
            "anthropic",
            "openai-compatible",
            "vscode"
          ],
          "enumDescriptions": [
            "AI hints are disabled (default). Nothing is sent anywhere.",
            "Ollama running on this computer (free, private). https://ollama.com",
            "LM Studio's local server on this computer (free, private). https://lmstudio.ai",
            "Anthropic's Claude API with your own API key.",
            "Any OpenAI-compatible API (OpenAI, OpenRouter, Groq, a school server…) with your own key.",
            "A model already available in VS Code, such as GitHub Copilot."
          ],
          "markdownDescription": "Where **AI hints** come from. Run **Sphynx: Set Up AI Hints** for a guided setup. API keys are stored in VS Code's encrypted secret storage, not in settings."
        },
        "sphynx.ai.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model to use for AI hints. Leave empty for the default: `claude-opus-5-5` for Anthropic, the first installed model for Ollama/LM Studio, any available model for VS Code. Required for `openai-compatible`."
        },
        "sphynx.ai.baseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "API base URL for AI hints. Required for `openai-compatible` (e.g. `https://api.openai.com/v1`). Optional for the others (defaults: Ollama `http://localhost:11434/v1`, LM Studio `http://localhost:1234/v1`)."
        },
        "sphynx.ai.responseLanguage": {
          "type": "string",
          "default": "",
          "markdownDescription": "Language for AI hints, e.g. `Português` or `English`. Leave empty to use VS Code's display language."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "challenge.json",
        "url": "./schemas/challenge.schema.json"
      },
      {
        "fileMatch": "exam.json",
        "url": "./schemas/exam.schema.json"
      },
      {
        "fileMatch": "quiz.json",
        "url": "./schemas/quiz.schema.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile && npm run bundle",
    "validate": "npm run compile && node scripts/validate-challenges.js",
    "package": "vsce package",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=out/extension.js --minify",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "fflate": "^0.8.3"
  }
}
