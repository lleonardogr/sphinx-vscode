{
  "name": "tech-challenges",
  "displayName": "Tech Challenges",
  "description": "LeetCode/HackerRank-style coding challenges inside VS Code. Starts with Java: variables, conditionals, loops, arrays, strings, methods and OOP.",
  "version": "0.1.0",
  "publisher": "class-plugin",
  "license": "MIT",
  "author": "lleonardogr",
  "repository": {
    "type": "git",
    "url": "https://github.com/lleonardogr/tech-challenges-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/lleonardogr/tech-challenges-vscode/issues"
  },
  "homepage": "https://github.com/lleonardogr/tech-challenges-vscode#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education"
  ],
  "keywords": [
    "java",
    "exercises",
    "challenges",
    "students",
    "practice",
    "education",
    "oop"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "techChallenges",
          "title": "Tech Challenges",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "techChallenges": [
        {
          "id": "techChallenges.list",
          "name": "Challenges"
        }
      ]
    },
    "commands": [
      {
        "command": "techChallenges.open",
        "title": "Open Challenge",
        "category": "Tech Challenges",
        "icon": "$(go-to-file)"
      },
      {
        "command": "techChallenges.run",
        "title": "Run Sample Tests",
        "category": "Tech Challenges",
        "icon": "$(play)"
      },
      {
        "command": "techChallenges.submit",
        "title": "Submit (Run All Tests)",
        "category": "Tech Challenges",
        "icon": "$(check-all)"
      },
      {
        "command": "techChallenges.runInTerminal",
        "title": "Run in Terminal (Type Input Yourself)",
        "category": "Tech Challenges",
        "icon": "$(terminal)"
      },
      {
        "command": "techChallenges.resetCode",
        "title": "Reset Code to Starter",
        "category": "Tech Challenges",
        "icon": "$(discard)"
      },
      {
        "command": "techChallenges.refresh",
        "title": "Reload Challenges",
        "category": "Tech Challenges",
        "icon": "$(refresh)"
      },
      {
        "command": "techChallenges.resetProgress",
        "title": "Reset All Progress",
        "category": "Tech Challenges",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "techChallenges.refresh",
          "when": "view == techChallenges.list",
          "group": "navigation"
        },
        {
          "command": "techChallenges.resetProgress",
          "when": "view == techChallenges.list"
        }
      ],
      "view/item/context": [
        {
          "command": "techChallenges.resetCode",
          "when": "view == techChallenges.list && viewItem == challenge"
        }
      ],
      "editor/title": [
        {
          "command": "techChallenges.run",
          "when": "techChallenges.isChallengeFile",
          "group": "navigation@1"
        },
        {
          "command": "techChallenges.runInTerminal",
          "when": "techChallenges.isChallengeFile",
          "group": "navigation@2"
        },
        {
          "command": "techChallenges.submit",
          "when": "techChallenges.isChallengeFile",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "techChallenges.resetCode",
          "when": "techChallenges.isChallengeFile"
        }
      ]
    },
    "keybindings": [
      {
        "command": "techChallenges.run",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "techChallenges.isChallengeFile"
      },
      {
        "command": "techChallenges.submit",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "techChallenges.isChallengeFile"
      }
    ],
    "configuration": {
      "title": "Tech Challenges",
      "properties": {
        "techChallenges.java.home": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a JDK installation (the folder that contains `bin/javac`). Leave empty to use `javac`/`java` from your PATH."
        },
        "techChallenges.java.style": {
          "type": "string",
          "enum": [
            "modern",
            "classic"
          ],
          "default": "modern",
          "enumDescriptions": [
            "Java 25+ compact source files: void main() and IO.println (requires JDK 25 or newer)",
            "Classic public class Main with public static void main(String[] args) and System.out.println (JDK 17+)"
          ],
          "markdownDescription": "Style of the starter code for new challenges. Both styles are always accepted when you run or submit, because only the output is checked. Use **Reset Code to Starter** to switch a challenge you already opened."
        },
        "techChallenges.codeFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder where your solutions are saved (one sub-folder per challenge). Leave empty to use `tech-challenges/` inside the open workspace, or the extension's private storage when no folder is open."
        },
        "techChallenges.extraChallengePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra folders containing challenges (same format as the built-in ones). Teachers can use this to hand out new challenges without rebuilding the extension."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "validate": "npm run compile && node scripts/validate-challenges.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
