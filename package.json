{
  "name": "sphynx",
  "displayName": "Sphinx Challenges",
  "description": "LeetCode/HackerRank-style coding challenges inside VS Code, with mixed-skill tests, quizzes, timed exams and optional AI hints from a local model or your own API key. Java Programming from variables to streams, and CS Fundamentals with lessons.",
  "version": "1.6.1",
  "publisher": "lleonardogr",
  "license": "MIT",
  "icon": "media/logo/icon.png",
  "galleryBanner": {
    "color": "#0d1627",
    "theme": "dark"
  },
  "author": "lleonardogr",
  "repository": {
    "type": "git",
    "url": "https://github.com/lleonardogr/sphinx-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/lleonardogr/sphinx-vscode/issues"
  },
  "homepage": "https://github.com/lleonardogr/sphinx-vscode#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Education"
  ],
  "keywords": [
    "ai",
    "challenges",
    "education",
    "exercises",
    "java",
    "oop",
    "practice",
    "students",
    "tutor"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sphinx",
          "title": "%viewContainer.title%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "sphinx": [
        {
          "id": "sphinx.list",
          "name": "%view.name%",
          "when": "sphinx.view != teacher"
        },
        {
          "id": "sphinx.teacher",
          "name": "%view.teacher%",
          "when": "sphinx.view == teacher"
        }
      ]
    },
    "commands": [
      {
        "command": "sphinx.open",
        "title": "%command.open%",
        "category": "Sphinx",
        "icon": "$(go-to-file)"
      },
      {
        "command": "sphinx.run",
        "title": "%command.run%",
        "category": "Sphinx",
        "icon": "$(play)"
      },
      {
        "command": "sphinx.submit",
        "title": "%command.submit%",
        "category": "Sphinx",
        "icon": "$(check-all)"
      },
      {
        "command": "sphinx.runInTerminal",
        "title": "%command.runInTerminal%",
        "category": "Sphinx",
        "icon": "$(terminal)"
      },
      {
        "command": "sphinx.resetCode",
        "title": "%command.resetCode%",
        "category": "Sphinx",
        "icon": "$(discard)"
      },
      {
        "command": "sphinx.resetChallenge",
        "title": "%command.resetChallenge%",
        "category": "Sphinx",
        "icon": "$(discard)"
      },
      {
        "command": "sphinx.resetQuiz",
        "title": "%command.resetQuiz%",
        "category": "Sphinx",
        "icon": "$(discard)"
      },
      {
        "command": "sphinx.resetAllChallenges",
        "title": "%command.resetAllChallenges%",
        "category": "Sphinx",
        "icon": "$(clear-all)"
      },
      {
        "command": "sphinx.refresh",
        "title": "%command.refresh%",
        "category": "Sphinx",
        "icon": "$(refresh)"
      },
      {
        "command": "sphinx.groupBy",
        "title": "%command.groupBy%",
        "category": "Sphinx",
        "icon": "$(list-filter)"
      },
      {
        "command": "sphinx.switchSubject",
        "title": "%command.switchSubject%",
        "category": "Sphinx",
        "icon": "$(library)"
      },
      {
        "command": "sphinx.openLesson",
        "title": "%command.openLesson%",
        "category": "Sphinx"
      },
      {
        "command": "sphinx.switchToTeacherView",
        "title": "%command.switchToTeacherView%",
        "category": "Sphinx",
        "icon": "$(briefcase)"
      },
      {
        "command": "sphinx.switchToStudentView",
        "title": "%command.switchToStudentView%",
        "category": "Sphinx",
        "icon": "$(mortar-board)"
      },
      {
        "command": "sphinx.editItem",
        "title": "%command.editItem%",
        "category": "Sphinx",
        "icon": "$(edit)"
      },
      {
        "command": "sphinx.revealItem",
        "title": "%command.revealItem%",
        "category": "Sphinx",
        "icon": "$(folder-opened)"
      },
      {
        "command": "sphinx.previewExam",
        "title": "%command.previewExam%",
        "category": "Sphinx",
        "icon": "$(play)"
      },
      {
        "command": "sphinx.restartPreview",
        "title": "%command.restartPreview%",
        "category": "Sphinx",
        "icon": "$(debug-restart)"
      },
      {
        "command": "sphinx.exportPack",
        "title": "%command.exportPack%",
        "category": "Sphinx",
        "icon": "$(package)"
      },
      {
        "command": "sphinx.classResults",
        "title": "%command.classResults%",
        "category": "Sphinx",
        "icon": "$(table)"
      },
      {
        "command": "sphinx.checkJava",
        "title": "%command.checkJava%",
        "category": "Sphinx",
        "icon": "$(pulse)"
      },
      {
        "command": "sphinx.chooseJdk",
        "title": "%command.chooseJdk%",
        "category": "Sphinx"
      },
      {
        "command": "sphinx.resetProgress",
        "title": "%command.resetProgress%",
        "category": "Sphinx",
        "icon": "$(clear-all)"
      },
      {
        "command": "sphinx.askAiHint",
        "title": "%command.askAiHint%",
        "category": "Sphinx",
        "icon": "$(sparkle)"
      },
      {
        "command": "sphinx.setupAi",
        "title": "%command.setupAi%",
        "category": "Sphinx",
        "icon": "$(settings-gear)"
      },
      {
        "command": "sphinx.clearAiKeys",
        "title": "%command.clearAiKeys%",
        "category": "Sphinx",
        "icon": "$(trash)"
      },
      {
        "command": "sphinx.createChallenge",
        "title": "%command.createChallenge%",
        "category": "Sphinx",
        "icon": "$(new-file)"
      },
      {
        "command": "sphinx.openQuiz",
        "title": "%command.openQuiz%",
        "category": "Sphinx"
      },
      {
        "command": "sphinx.importContent",
        "title": "%command.importContent%",
        "category": "Sphinx",
        "icon": "$(desktop-download)"
      },
      {
        "command": "sphinx.removeImported",
        "title": "%command.removeImported%",
        "category": "Sphinx"
      },
      {
        "command": "sphinx.createLesson",
        "title": "%command.createLesson%",
        "category": "Sphinx",
        "icon": "$(book)"
      },
      {
        "command": "sphinx.validateChallenges",
        "title": "%command.validateChallenges%",
        "category": "Sphinx",
        "icon": "$(checklist)"
      },
      {
        "command": "sphinx.startExam",
        "title": "%command.startExam%",
        "category": "Sphinx",
        "icon": "$(play)"
      },
      {
        "command": "sphinx.finishExam",
        "title": "%command.finishExam%",
        "category": "Sphinx",
        "icon": "$(debug-stop)"
      },
      {
        "command": "sphinx.openExamResults",
        "title": "%command.openExamResults%",
        "category": "Sphinx",
        "icon": "$(output)"
      },
      {
        "command": "sphinx.saveExamResults",
        "title": "%command.saveExamResults%",
        "category": "Sphinx",
        "icon": "$(save-as)"
      },
      {
        "command": "sphinx.verifyExamResults",
        "title": "%command.verifyExamResults%",
        "category": "Sphinx",
        "icon": "$(verified)"
      },
      {
        "command": "sphinx.copyBlocked",
        "title": "%command.copyBlocked%",
        "category": "Sphinx"
      },
      {
        "command": "sphinx.retakeExam",
        "title": "%command.retakeExam%",
        "category": "Sphinx",
        "icon": "$(debug-restart)"
      },
      {
        "command": "sphinx.deleteItem",
        "title": "%command.deleteItem%",
        "category": "Sphinx",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sphinx.importContent",
          "when": "view == sphinx.list",
          "group": "navigation@0"
        },
        {
          "command": "sphinx.switchSubject",
          "when": "view == sphinx.list",
          "group": "navigation@1"
        },
        {
          "command": "sphinx.groupBy",
          "when": "view == sphinx.list",
          "group": "navigation@1"
        },
        {
          "command": "sphinx.refresh",
          "when": "view == sphinx.list",
          "group": "navigation@1"
        },
        {
          "command": "sphinx.resetAllChallenges",
          "when": "view == sphinx.list",
          "group": "reset"
        },
        {
          "command": "sphinx.switchToTeacherView",
          "when": "view == sphinx.list",
          "group": "navigation@3"
        },
        {
          "command": "sphinx.removeImported",
          "when": "view == sphinx.list",
          "group": "import"
        },
        {
          "command": "sphinx.setupAi",
          "when": "view == sphinx.list",
          "group": "ai"
        },
        {
          "command": "sphinx.checkJava",
          "when": "view == sphinx.list",
          "group": "java"
        },
        {
          "command": "sphinx.createChallenge",
          "when": "view == sphinx.teacher",
          "group": "navigation@0"
        },
        {
          "command": "sphinx.importContent",
          "when": "view == sphinx.teacher",
          "group": "navigation@0"
        },
        {
          "command": "sphinx.refresh",
          "when": "view == sphinx.teacher",
          "group": "navigation@1"
        },
        {
          "command": "sphinx.switchToStudentView",
          "when": "view == sphinx.teacher",
          "group": "navigation@3"
        },
        {
          "command": "sphinx.createLesson",
          "when": "view == sphinx.teacher",
          "group": "authoring"
        },
        {
          "command": "sphinx.validateChallenges",
          "when": "view == sphinx.teacher",
          "group": "authoring"
        },
        {
          "command": "sphinx.verifyExamResults",
          "when": "view == sphinx.teacher",
          "group": "authoring"
        },
        {
          "command": "sphinx.removeImported",
          "when": "view == sphinx.teacher",
          "group": "import"
        },
        {
          "command": "sphinx.setupAi",
          "when": "view == sphinx.teacher",
          "group": "ai"
        },
        {
          "command": "sphinx.checkJava",
          "when": "view == sphinx.teacher",
          "group": "java"
        },
        {
          "command": "sphinx.exportPack",
          "when": "view == sphinx.teacher",
          "group": "authoring"
        },
        {
          "command": "sphinx.classResults",
          "when": "view == sphinx.teacher",
          "group": "authoring"
        }
      ],
      "view/item/context": [
        {
          "command": "sphinx.resetChallenge",
          "when": "view == sphinx.list && viewItem == challenge",
          "group": "inline"
        },
        {
          "command": "sphinx.resetChallenge",
          "when": "view == sphinx.list && viewItem == challenge",
          "group": "reset@2"
        },
        {
          "command": "sphinx.resetCode",
          "when": "view == sphinx.list && viewItem == challenge",
          "group": "reset@1"
        },
        {
          "command": "sphinx.resetQuiz",
          "when": "view == sphinx.list && viewItem == quiz",
          "group": "inline"
        },
        {
          "command": "sphinx.resetQuiz",
          "when": "view == sphinx.list && viewItem == quiz",
          "group": "reset"
        },
        {
          "command": "sphinx.startExam",
          "when": "view == sphinx.list && viewItem == exam-notStarted",
          "group": "inline"
        },
        {
          "command": "sphinx.startExam",
          "when": "view == sphinx.list && viewItem == exam-notStarted"
        },
        {
          "command": "sphinx.finishExam",
          "when": "view == sphinx.list && viewItem == exam-active",
          "group": "inline"
        },
        {
          "command": "sphinx.finishExam",
          "when": "view == sphinx.list && viewItem == exam-active"
        },
        {
          "command": "sphinx.openExamResults",
          "when": "view == sphinx.list && viewItem =~ /^exam-finished/",
          "group": "inline"
        },
        {
          "command": "sphinx.openExamResults",
          "when": "view == sphinx.list && viewItem =~ /^exam-finished/"
        },
        {
          "command": "sphinx.saveExamResults",
          "when": "view == sphinx.list && viewItem =~ /^exam-finished/"
        },
        {
          "command": "sphinx.retakeExam",
          "when": "view == sphinx.list && viewItem == exam-finished-retake",
          "group": "inline"
        },
        {
          "command": "sphinx.retakeExam",
          "when": "view == sphinx.list && viewItem == exam-finished-retake"
        },
        {
          "command": "sphinx.editItem",
          "when": "view == sphinx.teacher && viewItem =~ /^teacher(ExamOwn|Item|Question)$/",
          "group": "inline"
        },
        {
          "command": "sphinx.editItem",
          "when": "view == sphinx.teacher && viewItem =~ /^teacher(ExamOwn|Item|Question)$/",
          "group": "teacher@1"
        },
        {
          "command": "sphinx.revealItem",
          "when": "view == sphinx.teacher && viewItem =~ /^teacher(ExamOwn|Item|Question)$/",
          "group": "teacher@2"
        },
        {
          "command": "sphinx.previewExam",
          "when": "view == sphinx.teacher && viewItem =~ /^teacherExam/",
          "group": "inline@0"
        },
        {
          "command": "sphinx.previewExam",
          "when": "view == sphinx.teacher && viewItem =~ /^teacherExam/",
          "group": "teacher@0"
        },
        {
          "command": "sphinx.finishExam",
          "when": "view == sphinx.teacher && viewItem == teacherPreviewActive",
          "group": "inline"
        },
        {
          "command": "sphinx.finishExam",
          "when": "view == sphinx.teacher && viewItem == teacherPreviewActive",
          "group": "preview@1"
        },
        {
          "command": "sphinx.openExamResults",
          "when": "view == sphinx.teacher && viewItem == teacherPreviewFinished",
          "group": "inline"
        },
        {
          "command": "sphinx.openExamResults",
          "when": "view == sphinx.teacher && viewItem == teacherPreviewFinished",
          "group": "preview@1"
        },
        {
          "command": "sphinx.restartPreview",
          "when": "view == sphinx.teacher && viewItem =~ /^teacherPreview/",
          "group": "preview@2"
        },
        {
          "command": "sphinx.exportPack",
          "when": "view == sphinx.teacher && viewItem =~ /^teacher(ExamOwn|Item)$/",
          "group": "teacher@3"
        },
        {
          "command": "sphinx.classResults",
          "when": "view == sphinx.teacher && viewItem =~ /^teacherExam/",
          "group": "teacher@4"
        },
        {
          "command": "sphinx.deleteItem",
          "when": "view == sphinx.teacher && viewItem =~ /^teacher(ExamOwn|Item)$/",
          "group": "teacher@9"
        }
      ],
      "editor/title": [
        {
          "command": "sphinx.run",
          "when": "sphinx.isChallengeFile",
          "group": "navigation@1"
        },
        {
          "command": "sphinx.runInTerminal",
          "when": "sphinx.isChallengeFile",
          "group": "navigation@2"
        },
        {
          "command": "sphinx.submit",
          "when": "sphinx.isChallengeFile",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "sphinx.openLesson",
          "when": "false"
        },
        {
          "command": "sphinx.previewExam",
          "when": "false"
        },
        {
          "command": "sphinx.restartPreview",
          "when": "false"
        },
        {
          "command": "sphinx.editItem",
          "when": "false"
        },
        {
          "command": "sphinx.revealItem",
          "when": "false"
        },
        {
          "command": "sphinx.resetCode",
          "when": "sphinx.isChallengeFile"
        },
        {
          "command": "sphinx.askAiHint",
          "when": "sphinx.isChallengeFile"
        },
        {
          "command": "sphinx.resetQuiz",
          "when": "false"
        },
        {
          "command": "sphinx.copyBlocked",
          "when": "false"
        },
        {
          "command": "sphinx.deleteItem",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sphinx.run",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "sphinx.isChallengeFile"
      },
      {
        "command": "sphinx.submit",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "sphinx.isChallengeFile"
      },
      {
        "command": "sphinx.copyBlocked",
        "key": "ctrl+c",
        "when": "editorFocus && sphinx.examNoCopy",
        "mac": "cmd+c"
      },
      {
        "command": "sphinx.copyBlocked",
        "key": "ctrl+x",
        "when": "editorFocus && sphinx.examNoCopy",
        "mac": "cmd+x"
      },
      {
        "command": "sphinx.copyBlocked",
        "key": "ctrl+insert",
        "when": "editorFocus && sphinx.examNoCopy"
      },
      {
        "command": "sphinx.copyBlocked",
        "key": "shift+delete",
        "when": "editorFocus && sphinx.examNoCopy"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "sphinx.language": {
          "type": "string",
          "enum": [
            "en",
            "pt-br"
          ],
          "enumDescriptions": [
            "%config.language.en%",
            "%config.language.ptbr%"
          ],
          "default": "en",
          "markdownDescription": "%config.language%",
          "order": 0
        },
        "sphinx.java.home": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.java.home.description%"
        },
        "sphinx.java.style": {
          "type": "string",
          "enum": [
            "modern",
            "classic"
          ],
          "default": "modern",
          "enumDescriptions": [
            "%config.java.style.enum0%",
            "%config.java.style.enum1%"
          ],
          "markdownDescription": "%config.java.style.description%"
        },
        "sphinx.codeFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.codeFolder.description%"
        },
        "sphinx.extraChallengePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.extraChallengePaths.description%"
        },
        "sphinx.ai.provider": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "ollama",
            "lmstudio",
            "anthropic",
            "openai-compatible",
            "vscode"
          ],
          "enumDescriptions": [
            "%config.ai.provider.enum0%",
            "%config.ai.provider.enum1%",
            "%config.ai.provider.enum2%",
            "%config.ai.provider.enum3%",
            "%config.ai.provider.enum4%",
            "%config.ai.provider.enum5%"
          ],
          "markdownDescription": "%config.ai.provider.description%"
        },
        "sphinx.ai.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.ai.model.description%"
        },
        "sphinx.ai.baseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.ai.baseUrl.description%"
        },
        "sphinx.ai.responseLanguage": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.ai.responseLanguage.description%"
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "challenge.json",
        "url": "./schemas/challenge.schema.json"
      },
      {
        "fileMatch": "exam.json",
        "url": "./schemas/exam.schema.json"
      },
      {
        "fileMatch": "quiz.json",
        "url": "./schemas/quiz.schema.json"
      },
      {
        "fileMatch": "lesson.json",
        "url": "./schemas/lesson.schema.json"
      },
      {
        "fileMatch": "subject.json",
        "url": "./schemas/subject.schema.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile && npm run bundle",
    "validate": "npm run compile && node scripts/validate-challenges.js --strict --lang=pt-br",
    "test": "npm run compile && npm run test:unit && npm run test:integration",
    "test:unit": "node --test \"out/test/unit/*.test.js\"",
    "test:integration": "node out/test/runIntegration.js",
    "package": "vsce package",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=out/extension.js --minify",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "fflate": "^0.8.3"
  }
}
