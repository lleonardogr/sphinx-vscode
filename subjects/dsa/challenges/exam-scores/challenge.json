      "output": "100: 1\n85: 2\n70: 3\n55: 1\nmedian: 70\n"
    },
    {
      "input": "4\n10 20 30 40\n",
      "output": "40: 1\n30: 1\n20: 1\n10: 1\nmedian: 20\n"
    },
    {
