      "output": "........\n..#.....\n...#....\n.###....\n........\n........\n........\n........\n"
    },
    {
      "input": "3 3 1\n...\n###\n...\n",
      "output": ".#.\n.#.\n.#.\n"
    },
    {
      "input": "3 3 2\n...\n###\n...\n",
      "output": "...\n###\n...\n",
      "hidden": true
    },
    {
      "input": "4 4 5\n....\n.##.\n.##.\n....\n",
      "output": "....\n.##.\n.##.\n....\n",
      "hidden": true
