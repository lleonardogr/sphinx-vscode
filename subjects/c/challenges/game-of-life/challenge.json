{
  "title": "Game of Life",
  "topic": "CArrays",
  "requires": [
    "CFunctions",
    "Arrays"
  ],
  "difficulty": "Medium",
  "order": 4,
  "hints": [
    "Read the grid into a 2D char array, one cell at a time with scanf(\" %c\", …): the space skips the newlines.",
    "Count a cell's live neighbours by looking at the 8 cells around it, skipping any that fall outside the grid.",
    "Every cell must change at the same moment: compute the whole next generation into a second grid, then copy it back."
  ],
  "translations": {
    "pt-br": {
      "title": "Jogo da Vida",
      "hints": [
        "Leia a grade num array 2D de char, uma célula por vez com scanf(\" %c\", …): o espaço pula as quebras de linha.",
        "Conte os vizinhos vivos de uma célula olhando as 8 células em volta, pulando as que caem fora da grade.",
        "Todas as células precisam mudar no mesmo instante: calcule a próxima geração inteira numa segunda grade e depois copie de volta."
      ],
      "mustContain": [
        "Guarde a grade num array 2D."
      ],
      "bonus": [
        {
          "title": "Uma grade só",
          "description": "Use um só array 2D: sem segunda grade para montar a próxima geração. Cada célula tem espaço para mais de um bit.",
          "hint": "Guarde o estado atual no bit 0 e escreva o próximo estado no bit 1 (cell |= 2), lendo só o bit 0 (cell & 1) ao contar. Depois desloque cada célula um bit para a direita.",
          "mustNotContain": [
            "Declare só um array 2D (um parâmetro 2D também conta).",
            "Sem cópias nem memória extra: uma grade só."
          ]
        }
      ]
    }
  },
  "mustContain": [
    {
      "pattern": "\\[[^\\]]*\\]\\s*\\[",
      "message": "Keep the grid in a 2D array."
    }
  ],
  "tests": [
    {
