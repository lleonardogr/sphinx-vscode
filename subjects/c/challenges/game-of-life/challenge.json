  "bonus": [
    {
      "id": "one-grid",
      "title": "One grid only",
      "description": "Use a single 2D array: no second grid to build the next generation in. Each cell has room for more than one bit.",
      "hint": "Keep the current state in bit 0 and write the next state into bit 1 (cell |= 2), reading only bit 0 (cell & 1) while counting. Then shift every cell right by one.",
      "mustNotContain": [
        {
          "pattern": "\\w+\\s*\\[\\s*(\\d+|[A-Z_][A-Z0-9_]*)\\s*\\]\\s*\\[\\s*(\\d+|[A-Z_][A-Z0-9_]*)\\s*\\][\\s\\S]*\\w+\\s*\\[\\s*(\\d+|[A-Z_][A-Z0-9_]*)\\s*\\]\\s*\\[\\s*(\\d+|[A-Z_][A-Z0-9_]*)\\s*\\]",
          "message": "Declare only one 2D array (a 2D parameter counts too)."
        },
        {
          "pattern": "\\b(memcpy|memmove|malloc|calloc)\\b",
          "message": "No copies or extra memory: one grid only."
        }
      ]
    }
  ]
