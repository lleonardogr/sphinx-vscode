{
  "title": "Sum of Evens",
  "difficulty": "Easy",
  "mustContain": [
    {
      "pattern": "\\b(for|while)\\b",
      "message": "Use a loop (for or while)."
    }
  ],
  "hints": [
    "Keep a running total that starts at 0.",
    "Add a number to the total only when number % 2 == 0.",
    "Negative even numbers count too: -4 % 2 is 0."
  ],
  "tests": [
    {
      "input": "5\n1 2 3 4 5\n",
      "output": "6\n"
    },
    {
      "input": "3\n10 20 30\n",
      "output": "60\n"
    },
    {
      "input": "3\n1 3 5\n",
      "output": "0\n",
      "hidden": true
    },
    {
      "input": "4\n-2 -3 -4 7\n",
      "output": "-6\n",
      "hidden": true
    },
    {
      "input": "1\n0\n",
      "output": "0\n",
      "hidden": true
    }
  ]
}
